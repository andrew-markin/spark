{
  "name": "spark",
  "version": "1.0.0",
  "description": "Simple application for brain training",
  "author": "Andrew Markin",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write src/",
    "dataset": "node -r dotenv/config dataset.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "petite-vue-i18n": "^11.1.12",
    "pinia": "^4.1.0",
    "quasar": "^2.18.2",
    "vue": "^3.5.21",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@quasar/vite-plugin": "^2.0.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "dotenv": "^18.0.10",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-oxlint": "~1.93.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue": "~10.12.1",
    "flag-icons": "^7.6.0",
    "globals": "^17.14.0",
    "npm-run-all2": "^9.0.4",
    "oxlint": "~1.93.0",
    "prettier": "^3.6.2",
    "purgecss": "^8.0.0",
    "sass-embedded": "^1.92.1",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
