{
  "name": "spark",
  "version": "1.0.0",
  "description": "Simple application for brain training",
  "author": "Andrew Markin",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write src/",
    "dataset": "node -r dotenv/config dataset.js",
    "test": "vitest run",
    "demo": "node scripts/demo/record.js",
    "check-styles": "node scripts/check-styles.js"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "petite-vue-i18n": "^11.4.23",
    "pinia": "^4.1.0",
    "quasar": "^2.35.6",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@quasar/vite-plugin": "^2.0.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-oxlint": "~1.94.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue": "~10.12.1",
    "flag-icons": "^7.6.0",
    "globals": "^17.14.0",
    "npm-run-all2": "^9.1.0",
    "oxlint": "~1.94.0",
    "prettier": "^3.10.1",
    "purgecss": "^9.1.0",
    "sass-embedded": "^1.108.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
